# Required paths.
MODEL="/models/Qwen3-8B"
BENCH_TOKENIZER="${MODEL}"
MOONCAKE_TRACE_PATH="/data/mooncake/mooncake_synthetic_filtered.jsonl"
SERVED_MODEL_NAME="pd-transfer-model"

# P/D placement. The device count must equal the corresponding TP size.
PREFILL_DEVICES="0"
PREFILL_TP_SIZE=1
DECODE_DEVICES="1"
DECODE_TP_SIZE=1

# Example heterogeneous layouts on eight GPUs:
# PREFILL_DEVICES="0,1"
# PREFILL_TP_SIZE=2
# DECODE_DEVICES="2,3,4,5"
# DECODE_TP_SIZE=4

HOST="127.0.0.1"
PREFILL_PORT=8100
DECODE_PORT=8200
PROXY_PORT=9000
PREFILL_SIDE_CHANNEL_PORT=5600
DECODE_SIDE_CHANNEL_PORT=5601
PREFILL_ENGINE_ID="prefill-engine"
DECODE_ENGINE_ID="decode-engine"

MAX_MODEL_LEN=40960
PREFILL_MAX_NUM_BATCHED_TOKENS=40960
DECODE_MAX_NUM_BATCHED_TOKENS=40960
PREFILL_MAX_NUM_SEQS=64
DECODE_MAX_NUM_SEQS=64
PREFILL_GPU_MEMORY_UTILIZATION=0.90
DECODE_GPU_MEMORY_UTILIZATION=0.90

# Mooncake FAST'25 trace fields use 512-token hash blocks and millisecond
# timestamps. Change TRACE_TIME_SCALE to 0.0005 for 2x arrival rate, etc.
MOONCAKE_BLOCK_SIZE=512
TRACE_TIME_SCALE=0.001
NUM_PROMPTS=1000
MAX_CONCURRENCY=128

# Warm up the complete P -> D transfer path with a content-disjoint Random
# workload. Set WARMUP_PROMPTS=0 to disable it.
WARMUP_PROMPTS=4
WARMUP_INPUT_LEN=4096
WARMUP_OUTPUT_LEN=16
WARMUP_CONCURRENCY=1
WARMUP_SEED=900000

RESULT_ROOT="results/pd_transfer_v024"
COMMON_VLLM_ARGS="--seed 1024 --trust-remote-code --enforce-eager"
PREFILL_EXTRA_ARGS=""
DECODE_EXTRA_ARGS=""
BENCH_EXTRA_ARGS="--percentile-metrics ttft,tpot,itl,e2el --metric-percentiles 50,90,99"
WARMUP_EXTRA_ARGS=""

UCX_NET_DEVICES="all"
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
CLEANUP_GRACE_SECONDS=5
