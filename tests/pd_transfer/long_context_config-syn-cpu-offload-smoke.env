# P-only CPU KV offload smoke for the Mooncake Synthetic motivation sample.
# This intentionally runs one traced, low-load case before a larger capacity
# or repetition sweep. On Qwen3-8B, 128 x 512-token blocks use roughly 9 GiB of
# pinned host memory for KV data.
MODEL="/models/Qwen3-8B"
BENCH_TOKENIZER="${MODEL}"
SERVED_MODEL_NAME="pd-transfer-model"
PREFILL_DEVICES="5"
DECODE_DEVICES="6"
TP_SIZE=1

HOST="127.0.0.1"
PREFILL_PORT=8101
DECODE_PORT=8201
PROXY_PORT=9001
PREFILL_SIDE_CHANNEL_PORT=5602
DECODE_SIDE_CHANNEL_PORT=5603
PREFILL_ENGINE_ID="prefill-engine"
DECODE_ENGINE_ID="decode-engine"

DATASET_PATH="/workspace/vllm-study/dataset/mooncake_synthetic_motivation_500.jsonl"
DATASET_LOADER="mooncake"
WORKLOAD_NAME="mooncake-fast25-synthetic-prefix-trace-cpu-offload-smoke"
WORKLOAD_SLUG="mooncake-synthetic-cpu-offload"
DATASET_SOURCE_FORMAT="mooncake-fast25-jsonl"
MOONCAKE_BLOCK_SIZE=512
MOONCAKE_TOKEN_SEED=0

# Skip the trace-disabled matrix and run one 50-request diagnostic at the
# stable low-load point. Increase to 500 only after the smoke passes.
REQUEST_RATES="0.08"
NUM_PROMPTS=0
REPETITIONS=1
VARIANT_MODE="off"
PAIRED_AXIS="reverse"
TRANSFER_MODE_A="direct"
TRANSFER_MODE_B="auto"
REVERSE_VARIANT="off"
TRANSFER_DELAY_MS_LIST="0"

NIXL_TRANSFER_MODE="direct"
NIXL_PACKED_STAGING_MIB=64
NIXL_PACKED_STAGING_SLOTS=16
PREFILL_PACKED_STAGING_SLOTS=16
DECODE_PACKED_STAGING_SLOTS=16
NIXL_PACKED_AUTO_RANGE_THRESHOLD=64

PREFILL_CPU_KV_OFFLOAD=1
PREFILL_CPU_KV_BLOCK_SIZE=512
PREFILL_CPU_KV_NUM_BLOCKS=128

MAX_CONCURRENCY=""
WARMUP_PROMPTS=2
WARMUP_INPUT_LEN=4096
WARMUP_OUTPUT_LEN=16
WARMUP_CONCURRENCY=1
WARMUP_SEED=900000

BENCH_SEED=1024
BENCH_TEMPERATURE=0
IGNORE_EOS=1
SAVE_DETAILED=1

RUN_DIAGNOSTIC_TRACE=1
DIAGNOSTIC_REQUEST_RATES="0.08"
DIAGNOSTIC_NUM_PROMPTS=50
DIAGNOSTIC_REPETITIONS=1
DIAGNOSTIC_TRANSFER_DELAY_MS_LIST="0"

RESULT_ROOT="results/pd_transfer_long_context"
SERVER_EXTRA_ARGS="--enable-prefix-caching --max-model-len 40960"
PREFILL_EXTRA_ARGS=""
DECODE_EXTRA_ARGS=""
BENCH_EXTRA_ARGS=""
WARMUP_EXTRA_ARGS=""

UCX_NET_DEVICES="all"
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
