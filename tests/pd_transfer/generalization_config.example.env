# Required model and topology settings.
MODEL="/path/to/model"
BENCH_TOKENIZER="${MODEL}"
SERVED_MODEL_NAME="pd-transfer-model"
PREFILL_DEVICES="0"
DECODE_DEVICES="1"
TP_SIZE=1

HOST="127.0.0.1"
PREFILL_PORT=8100
DECODE_PORT=8200
PROXY_PORT=9000
PREFILL_SIDE_CHANNEL_PORT=5600
DECODE_SIDE_CHANNEL_PORT=5601
PREFILL_ENGINE_ID="prefill-engine"
DECODE_ENGINE_ID="decode-engine"

# Use the v1.1 CSV format expected by the vLLM 0.11 BurstGPT loader.
DATASET_PATH="/data/BurstGPT_without_fails_2.csv"
WORKLOAD_NAME="burstgpt-v1.1"
WORKLOAD_SLUG="burstgpt"
DATASET_SOURCE_FORMAT="burstgpt-v1.1-csv"

# Each request-rate case is isolated in fresh P/D processes. Odd repetitions
# run OFF then ON; even repetitions run ON then OFF. Calibrate these request
# rates for the target model/GPU before the final run.
REQUEST_RATES="1 2 4"
NUM_PROMPTS=1000
REPETITIONS=3
# Keep this at zero for the paired OFF/ON optimization comparison. For a
# transfer-latency sensitivity sweep, set VARIANT_MODE=off (or on) and use, for
# example, "0 50 100 200". Each value starts fresh P/D processes.
TRANSFER_DELAY_MS_LIST="0"

# NIXL transfer path. Use direct/packed for A/B runs, then auto after the
# end-to-end boundary is calibrated.
NIXL_TRANSFER_MODE=direct
NIXL_PACKED_STAGING_MIB=64
NIXL_PACKED_STAGING_SLOTS=2
NIXL_PACKED_AUTO_RANGE_THRESHOLD=16
NIXL_PACKED_AUTO_BLOCK_THRESHOLD=32

# Leave empty to avoid a client-side concurrency cap.
MAX_CONCURRENCY=""

# Warm-up uses a separate Random workload so it cannot prefix-hit the formal
# BurstGPT requests.
WARMUP_PROMPTS=20
WARMUP_INPUT_LEN=512
WARMUP_OUTPUT_LEN=32
WARMUP_CONCURRENCY=1
WARMUP_SEED=900000

BENCH_SEED=1024
BENCH_TEMPERATURE=0
IGNORE_EOS=1
SAVE_DETAILED=1

# Main performance runs do not emit PD JSONL traces. A separate OFF/ON
# diagnostic pair verifies that the optimization is actually exercised.
RUN_DIAGNOSTIC_TRACE=1
DIAGNOSTIC_REQUEST_RATE=4
DIAGNOSTIC_NUM_PROMPTS=1000
# Defaults to REPETITIONS. Set independently when diagnostic and performance
# cases need different repeat counts.
DIAGNOSTIC_REPETITIONS=3
# Defaults to the first TRANSFER_DELAY_MS_LIST value when unset. A sensitivity
# run can use only its endpoints here, for example "0 200".
DIAGNOSTIC_TRANSFER_DELAY_MS_LIST=""

RESULT_ROOT="results/pd_transfer_generalization"

# Keep these empty for default vLLM behavior. Add only model-required options,
# for example --trust-remote-code.
SERVER_EXTRA_ARGS=""
PREFILL_EXTRA_ARGS=""
DECODE_EXTRA_ARGS=""
BENCH_EXTRA_ARGS=""
WARMUP_EXTRA_ARGS=""

# Optional transport and offline settings.
UCX_NET_DEVICES="all"
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
