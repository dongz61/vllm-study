# Required model and topology settings.
MODEL="/path/to/model"
BENCH_TOKENIZER="${MODEL}"
SERVED_MODEL_NAME="pd-transfer-model"
PREFILL_DEVICES="0"
DECODE_DEVICES="1"
TP_SIZE=1

HOST="127.0.0.1"
PREFILL_PORT=8100
DECODE_PORT=8200
PROXY_PORT=9000
PREFILL_SIDE_CHANNEL_PORT=5600
DECODE_SIDE_CHANNEL_PORT=5601
PREFILL_ENGINE_ID="prefill-engine"
DECODE_ENGINE_ID="decode-engine"

# Convert Mooncake FAST'25 synthetic_trace.jsonl with:
# python tests/pd_transfer/prepare_mooncake_trace.py \
#   dataset/synthetic_trace.jsonl dataset/mooncake_synthetic_filtered.jsonl \
#   --max-total-tokens 40960
DATASET_PATH="/data/mooncake_synthetic_filtered.jsonl"
DATASET_LOADER="mooncake"
WORKLOAD_NAME="mooncake-fast25-synthetic-prefix-trace"
WORKLOAD_SLUG="mooncake-synthetic"
# For the two real traces, change the three values above to the filtered
# conversation or toolagent JSONL and matching workload names/slugs.
DATASET_SOURCE_FORMAT="mooncake-fast25-jsonl"
MOONCAKE_BLOCK_SIZE=512
MOONCAKE_TOKEN_SEED=0

# For Mooncake, REQUEST_RATES are multipliers of the recorded timestamp rate:
# 1.0 is native timing, 0.5 is half rate, and 2.0 is double rate. These are
# calibration starting points, not final universal rates.
REQUEST_RATES="0.1 0.2 0.4"
# Set to 0 to skip trace-disabled performance runs and execute only the
# trace-enabled diagnostic run. In that mode RUN_DIAGNOSTIC_TRACE must be 1.
NUM_PROMPTS=200
REPETITIONS=3
# paired alternates OFF/ON order across repetitions. Set off or on to run
# only that canonicalization variant, for example during a smoke test.
VARIANT_MODE="paired"
# Keep this at zero for paired OFF/ON runs. To measure TTFT sensitivity to
# additional non-blocking transfer completion latency, set VARIANT_MODE=off
# (or on) and use a sweep such as "0 50 100 200".
TRANSFER_DELAY_MS_LIST="0"

# NIXL path for direct/packed/auto end-to-end comparisons.
NIXL_TRANSFER_MODE=direct
NIXL_PACKED_STAGING_MIB=64
NIXL_PACKED_STAGING_SLOTS=64
NIXL_PACKED_AUTO_RANGE_THRESHOLD=64

# Leave empty to avoid a client-side concurrency cap.
MAX_CONCURRENCY=""

# Warm-up is request-content-disjoint from the converted Mooncake workload.
# The formal 200-request workload itself turns over several KV-cache capacities.
WARMUP_PROMPTS=4
WARMUP_INPUT_LEN=4096
WARMUP_OUTPUT_LEN=16
WARMUP_CONCURRENCY=1
WARMUP_SEED=900000

BENCH_SEED=1024
BENCH_TEMPERATURE=0
IGNORE_EOS=1
SAVE_DETAILED=1

# Main performance cases do not emit traces. This separate pair measures how
# much of the transferred workload actually consists of paired-reverse runs.
RUN_DIAGNOSTIC_TRACE=1
# Optional whitespace-separated rate sweep. If unset, the legacy singular
# DIAGNOSTIC_REQUEST_RATE setting below is used instead.
DIAGNOSTIC_REQUEST_RATES=""
DIAGNOSTIC_REQUEST_RATE=0.2
DIAGNOSTIC_NUM_PROMPTS=200
# Defaults to REPETITIONS. Each repeat gets an isolated rep-N directory.
DIAGNOSTIC_REPETITIONS=3
# Defaults to the first TRANSFER_DELAY_MS_LIST value. A delay sweep normally
# needs tracing only at selected validation points, for example "0 200".
DIAGNOSTIC_TRANSFER_DELAY_MS_LIST=""

RESULT_ROOT="results/pd_transfer_long_context"

# Prefix caching is part of the workload and is enabled explicitly on P and D.
# Add only other model-required options after this flag.
SERVER_EXTRA_ARGS="--enable-prefix-caching --max-model-len 40960"
PREFILL_EXTRA_ARGS=""
DECODE_EXTRA_ARGS=""
BENCH_EXTRA_ARGS=""
WARMUP_EXTRA_ARGS=""

# Optional transport and offline settings.
UCX_NET_DEVICES="all"
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
