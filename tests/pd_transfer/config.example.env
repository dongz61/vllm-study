# Required.
MODEL="/path/to/model"
BENCH_TOKENIZER="${MODEL}"
SERVED_MODEL_NAME="pd-transfer-model"

# One GPU per process by default. For TP>1, list comma-separated devices.
PREFILL_DEVICES="0"
DECODE_DEVICES="1"
TP_SIZE=1

HOST="127.0.0.1"
PREFILL_PORT=8100
DECODE_PORT=8200
PROXY_PORT=9000
PREFILL_SIDE_CHANNEL_PORT=5600
DECODE_SIDE_CHANNEL_PORT=5601
PREFILL_ENGINE_ID="prefill-engine"
DECODE_ENGINE_ID="decode-engine"

MAX_MODEL_LEN=20000
MAX_NUM_BATCHED_TOKENS=20000
MAX_NUM_SEQS=64
GPU_MEMORY_UTILIZATION=0.9

# Benchmark matrix.
INPUT_LENS="1024 4096 8192 16384"
OUTPUT_LENS="1 32 128"
CONCURRENCIES="1"
NUM_FOLDS=50
RANDOM_PREFIX_LEN=0

# Artificial delay injected when D reports KV transfer completion.
TRANSFER_SLEEP_MS_LIST="0 5 10 20 50 100"

# Optional explicit case list. If set, the script ignores INPUT_LENS,
# OUTPUT_LENS, CONCURRENCIES, and TRANSFER_SLEEP_MS_LIST, and runs only these
# cases. Each entry is input,output,concurrency,sleep_ms.
# BENCH_CASES="2048,32,1,0 2048,32,1,20 4096,32,1,0 4096,32,1,40"

RESULT_ROOT="results/pd_transfer"

COMMON_VLLM_ARGS="--seed 1024 --trust-remote-code --enforce-eager --no-enable-prefix-caching"
PREFILL_EXTRA_ARGS=""
DECODE_EXTRA_ARGS=""
BENCH_EXTRA_ARGS="--ignore-eos --percentile-metrics ttft,tpot,itl,e2el --metric-percentiles 50,90,99"

# Optional transport/env settings.
UCX_NET_DEVICES="all"
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
